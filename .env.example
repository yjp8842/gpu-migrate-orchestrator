# 오케스트레이터 환경변수 견본 — .env 로 복사해 채운다 (.env 는 .gitignore).
# migrate 가 시작할 때 프로젝트 폴더의 .env 를 읽는다. 셸에서 export 한 값이 이 파일보다 우선한다.

# Tumblebug — 예: http://<서버>:1323/tumblebug
GMP_TB_URL=
GMP_TB_USER=
GMP_TB_PASSWORD=

# Beetle — 예: http://<서버>:8056/beetle (밖에서 막혀 있으면 Beetle UI 의 프록시 http://<서버>:3080/beetle)
GMP_BEETLE_URL=
GMP_BEETLE_USER=
GMP_BEETLE_PASSWORD=

# 타겟 웹 포트(80)를 열 출발지 — 예: 사무실 공인 IP/32
GMP_WEB_ALLOW_CIDR=

# 타겟 검증에 쓰는 WidgetRAG 관리자 비밀번호 — 소스와 같은 값 (WidgetRAG 기본값, 소스를 다른 값으로 띄웠으면 그 값)
GMP_VERIFY_ADMIN_PASSWORD=admin_password

# 선택 — 증적 폴더 (기본 evidence, 설정 파일 기준 상대 경로)
# GMP_EVIDENCE_ROOT=../검증_로그/pipeline
